{
  "name": "VideoProgress",
  "type": "object",
  "properties": {
    "clienta_id": {
      "type": "string",
      "title": "Clienta (User ID)"
    },
    "enrollment_id": {
      "type": "string",
      "title": "Enrollment ID"
    },
    "program_day_id": {
      "type": "string",
      "title": "ProgramDay ID"
    },
    "duration_seconds": {
      "type": "number",
      "title": "Duraci\u00f3n total del video (segundos)"
    },
    "watched_buckets_json": {
      "type": "string",
      "title": "Buckets vistos (JSON)"
    },
    "unique_watched_seconds": {
      "type": "number",
      "title": "Segundos \u00fanicos vistos",
      "default": 0
    },
    "valid_percent": {
      "type": "number",
      "title": "Porcentaje v\u00e1lido de visualizaci\u00f3n",
      "default": 0,
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "superadmin"
              }
            },
            {
              "user_condition": {
                "data.app_role": "operaciones"
              }
            }
          ]
        }
      }
    },
    "last_position_seconds": {
      "type": "number",
      "title": "\u00daltima posici\u00f3n (segundos)",
      "default": 0
    },
    "completed": {
      "type": "boolean",
      "title": "Completado",
      "default": false,
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "superadmin"
              }
            },
            {
              "user_condition": {
                "data.app_role": "operaciones"
              }
            }
          ]
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha de completado",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "superadmin"
              }
            },
            {
              "user_condition": {
                "data.app_role": "operaciones"
              }
            }
          ]
        }
      }
    },
    "last_saved_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u00daltimo guardado"
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "clienta"
          }
        },
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.clienta_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.clienta_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    }
  },
  "required": [
    "clienta_id",
    "program_day_id"
  ]
}