{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor_user_id": {
      "type": "string",
      "title": "Usuario que realiz\u00f3 la acci\u00f3n (User ID)"
    },
    "action": {
      "type": "string",
      "title": "Acci\u00f3n realizada"
    },
    "entity_type": {
      "type": "string",
      "title": "Tipo de entidad"
    },
    "entity_id": {
      "type": "string",
      "title": "ID de entidad"
    },
    "old_value_json": {
      "type": "string",
      "title": "Valor anterior (JSON)"
    },
    "new_value_json": {
      "type": "string",
      "title": "Valor nuevo (JSON)"
    },
    "reason": {
      "type": "string",
      "title": "Raz\u00f3n de la acci\u00f3n"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha y hora"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.app_role": "superadmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "superadmin"
      }
    }
  },
  "required": [
    "actor_user_id",
    "action"
  ]
}