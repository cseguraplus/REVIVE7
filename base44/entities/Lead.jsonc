{
  "name": "Lead",
  "type": "object",
  "properties": {
    "source_domain": {
      "type": "string",
      "title": "Dominio de origen"
    },
    "lead_type": {
      "type": "string",
      "title": "Tipo de lead",
      "enum": [
        "aliada_application",
        "clienta_or_prospect",
        "general_prospect"
      ]
    },
    "full_name": {
      "type": "string",
      "title": "Nombre completo"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email (opcional)"
    },
    "phone": {
      "type": "string",
      "title": "WhatsApp"
    },
    "ciudad": {
      "type": "string",
      "title": "Ciudad o zona"
    },
    "intensity_interest": {
      "type": "string",
      "title": "Intensidad de inter\u00e9s",
      "enum": [
        "renueva_7",
        "activa_7",
        "evoluciona_7",
        "orientacion"
      ]
    },
    "referral_code": {
      "type": "string",
      "title": "C\u00f3digo de referido"
    },
    "campaign": {
      "type": "string",
      "title": "Campa\u00f1a / UTM"
    },
    "consent": {
      "type": "boolean",
      "title": "Consentimiento",
      "default": false
    },
    "assigned_aliada_id": {
      "type": "string",
      "title": "Aliada asignada (AliadaProfile ID)"
    },
    "assignment_status": {
      "type": "string",
      "title": "Estado de asignaci\u00f3n",
      "enum": [
        "assigned_to_aliada",
        "general_prospect",
        "pending"
      ],
      "default": "general_prospect"
    },
    "ip": {
      "type": "string",
      "title": "IP de origen"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "rejected"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "superadmin"
          }
        },
        {
          "user_condition": {
            "data.app_role": "operaciones"
          }
        }
      ]
    }
  },
  "required": [
    "source_domain",
    "lead_type",
    "full_name",
    "phone",
    "consent"
  ]
}